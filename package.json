{
  "name": "sonargate",
  "version": "1.0.0",
  "private": true,
  "description": "SonarGate — AI visibility observation aggregation gateway",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . && prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/unit/**/*.ts\" \"test/integration/**/*.ts\" \"vitest.config.ts\" \"eslint.config.mjs\" \"package.json\" \"tsconfig*.json\" \".prettierrc\"",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/unit/**/*.ts\" \"test/integration/**/*.ts\" \"vitest.config.ts\" \"eslint.config.mjs\" \"package.json\" \"tsconfig*.json\" \".prettierrc\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:e2e": "VITEST_E2E=1 vitest run",
    "smoke": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "fastify": "^5.3.0",
    "lru-cache": "^11.1.0",
    "undici": "^8.12.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  }
}
