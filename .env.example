# === Server & Auth ===
HOST=0.0.0.0
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
# 至少配置一个强随机密钥；轮换期间可用英文逗号分隔多个密钥（亦兼容单值 GATEWAY_API_KEY）
GATEWAY_API_KEYS=replace-with-32byte-random-hex

# === Budget, Resilience & Cache ===
GATEWAY_REQUEST_TIMEOUT_MS=105000
DOMESTIC_TIMEOUT_MS=45000
OVERSEAS_TIMEOUT_MS=85000
MAX_UPSTREAM_RETRIES=2
RETRY_BASE_DELAY_MS=1000
SEMAPHORE_WAIT_MS=15000
DOMESTIC_CONCURRENCY_PER_ENGINE=5
DATAFORSEO_CONCURRENCY=10
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=2000

# === Domestic 1: Doubao (Volcengine Ark) ===
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
DOUBAO_EXTRA_BODY_JSON={}

# === Domestic 2: DeepSeek ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SEARCH_PARAMS_JSON={"web_search":true}

# === Domestic 3: Tongyi (Alibaba DashScope) ===
TONGYI_API_KEY=
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TONGYI_MODEL=qwen-plus
TONGYI_SEARCH_STRATEGY=standard

# === Domestic 4: Zhipu (BigModel) ===
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus
ZHIPU_SEARCH_ENGINE=search_pro

# === Domestic 5: Wenxin (Baidu Qianfan V2) ===
WENXIN_API_KEY=
WENXIN_BASE_URL=https://qianfan.baidubce.com/v2
WENXIN_MODEL=ernie-4.5-turbo-128k

# === Overseas: DataForSEO ===
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_COUNTRY_ISO=US
DATAFORSEO_PERPLEXITY_MODEL=sonar
DATAFORSEO_CLAUDE_MODEL=claude-sonnet-4-5
DATAFORSEO_GEMINI_MODE=scraper
DATAFORSEO_GEMINI_MODEL=gemini-2.5-flash
# 可选覆盖 Gemini 端点路径（如 /v3/ai_optimization/gemini/llm_responses/live）
# DATAFORSEO_GEMINI_ENDPOINT=

# === Overseas Option B: OpenAI-Compatible Relay (NewAPI / SubAPI / OpenRouter) ===
# 可选值: auto（默认：已配 DataForSEO 走 DataForSEO，否则已配中转站自动走 openai_compat）| dataforseo | openai_compat
OVERSEAS_PROVIDER=auto
OVERSEAS_RELAY_BASE_URL=
OVERSEAS_RELAY_API_KEY=

# 单引擎可选覆盖（不填则继承 OVERSEAS_PROVIDER / OVERSEAS_RELAY_BASE_URL / OVERSEAS_RELAY_API_KEY）
# CHATGPT_PROVIDER=openai_compat
# CHATGPT_BASE_URL=
# CHATGPT_API_KEY=
CHATGPT_MODEL=gpt-4o-search-preview
CHATGPT_EXTRA_BODY_JSON={}

# PERPLEXITY_PROVIDER=openai_compat
# PERPLEXITY_BASE_URL=
# PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_EXTRA_BODY_JSON={}

# GEMINI_PROVIDER=openai_compat
# GEMINI_BASE_URL=
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EXTRA_BODY_JSON={}

# CLAUDE_PROVIDER=openai_compat
# CLAUDE_BASE_URL=
# CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_EXTRA_BODY_JSON={}

# TODO: openai_compat 模式下 google_aio 默认复用 GEMINI_MODEL 作为占位，后续可替换为专用 SERP/AIO 驱动
# GOOGLE_AIO_PROVIDER=openai_compat
# GOOGLE_AIO_BASE_URL=
# GOOGLE_AIO_API_KEY=
# GOOGLE_AIO_MODEL=
GOOGLE_AIO_EXTRA_BODY_JSON={}

